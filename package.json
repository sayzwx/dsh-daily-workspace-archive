{
  "name": "dsh-daily-workspace",
  "version": "1.1.0",
  "description": "Default daily workspace for DeepSeek Harness: new conversations open in a folder you choose, with recent conversations above the workspace groups.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayzwx/dsh-daily-workspace.git"
  },
  "homepage": "https://github.com/sayzwx/dsh-daily-workspace#readme",
  "bugs": {
    "url": "https://github.com/sayzwx/dsh-daily-workspace/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "workspace",
    "sidebar"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": "^0.2.2-rc.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
